# ============================================================

def tampilkan_papan_catur():
    print("\n" + "=" * 40)
    print("         PAPAN CATUR 8x8")
    print("=" * 40)

    for baris in range(8):
        for kolom in range(8):
            if (baris + kolom) % 2 == 0:
                print("⬛", end="")
            else:
                print("⬜", end="")
        print()

    print()

